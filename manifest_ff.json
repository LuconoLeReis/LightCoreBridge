{
  "name": "LightCore Bridge",
  "short_name": "LightCore",
  "version": "2.20.254",
  "manifest_version": 2,
  "description": "Connect your D&D Beyond character to your table: local play, Roll20, Foundry VTT, TaleSpire and Discord.",
  "permissions": [
    "http://127.0.0.1:48874/*",
    "activeTab",
    "tabs",
    "storage",
    "*://beyond20.kicks-ass.org/roll",
    "*://app.roll20.net/editor/",
    "*://*.dndbeyond.com/*",
    "*://*.forge-vtt.com/game"
  ],
  "optional_permissions": [
    "*://*/",
    "webNavigation"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "beyond20@kakaroto.homelinux.net"
    }
  },
  "icons": {
    "16": "images/icons/icon16.png",
    "24": "images/icons/icon24.png",
    "32": "images/icons/icon32.png",
    "48": "images/icons/icon48.png",
    "64": "images/icons/icon64.png",
    "128": "images/icons/icon128.png",
    "256": "images/icons/icon256.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_action": {
    "default_popup": "default_popup.html",
    "default_icon": {
      "16": "images/icons/icon16.png",
      "24": "images/icons/icon24.png",
      "32": "images/icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    "images/*",
    "libs/css/alertify.css",
    "libs/css/alertify-themes/default.css",
    "libs/css/alertify-themes/beyond20.css",
    "libs/alertify.min.js",
    "libs/jquery-3.4.1.min.js",
    "libs/lz-string.min.js",
    "dist/roll20_script.js",
    "dist/fvtt_script.js",
    "dist/dndbeyond_mb.js",
    "popup.html",
    "options.html",
    "dist/compat_dndbeyond_mb.js",
    "dist/compat_roll20_script.js",
    "dist/compat_fvtt_script.js"
  ],
  "background": {
    "persistent": true,
    "scripts": [
      "dist/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dndbeyond.com/*characters/*",
        "*://*.dndbeyond.com/characters"
      ],
      "js": [
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dndbeyond.com/monsters/*"
      ],
      "js": [
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dndbeyond.com/vehicles/*"
      ],
      "js": [
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dndbeyond.com/spells/*"
      ],
      "js": [
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dndbeyond.com/my-encounters",
        "*://*.dndbeyond.com/encounters/*",
        "*://*.dndbeyond.com/combat-tracker/*"
      ],
      "js": [
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dndbeyond.com/equipment/*",
        "*://*.dndbeyond.com/magic-items/*"
      ],
      "js": [
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dndbeyond.com/feats/*"
      ],
      "js": [
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dndbeyond.com/sources/*",
        "*://*.dndbeyond.com/classes/*",
        "*://*.dndbeyond.com/races/*",
        "*://*.dndbeyond.com/species/*",
        "*://*.dndbeyond.com/backgrounds/*"
      ],
      "exclude_matches": [
        "*://*.dndbeyond.com/classes/*/edit",
        "*://*.dndbeyond.com/races/*/edit",
        "*://*.dndbeyond.com/species/*/edit",
        "*://*.dndbeyond.com/backgrounds/*/edit"
      ],
      "js": [
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "*://app.roll20.net/editor/*"
      ],
      "js": [
        "libs/alertify.min.js",
        "libs/jquery-3.4.1.min.js",
        "dist/recovery_boot.js"
      ]
    }
  ],
  "version_name": "LightCore Bridge 1.73.122"
}
